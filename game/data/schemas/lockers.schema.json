{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Locker themes",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "categories", "item_count", "junk_weight"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "categories": {
        "description": "Relative chance of each item category, per item",
        "type": "object",
        "minProperties": 1,
        "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
        "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
      },
      "item_count": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 1}
      },
      "junk_weight": {
        "description": "Pounds of scrap, [min, max]",
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 0}
      }
    }
  }
}
