{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game-wide tuning numbers",
  "type": "object",
  "additionalProperties": false,
  "required": ["starting_cash", "starting_vehicle", "starting_zone", "rent", "scrap", "conditions", "dirty", "auction", "shop"],
  "properties": {
    "starting_cash": {"type": "integer", "minimum": 0},
    "starting_vehicle": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "starting_zone": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "rent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "every_days"],
      "properties": {
        "amount": {"type": "integer", "minimum": 0},
        "every_days": {"type": "integer", "minimum": 1}
      }
    },
    "scrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_pound", "job_pay"],
      "properties": {
        "per_pound": {"type": "number", "minimum": 0},
        "job_pay": {"type": "integer", "minimum": 0}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "multipliers", "weights"],
      "properties": {
        "order": {
          "description": "Worst to best",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "multipliers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "dirty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chance", "multiplier"],
      "properties": {
        "chance": {"type": "number", "minimum": 0, "maximum": 1},
        "multiplier": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "auction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peek_seconds", "visible_share", "countdown_seconds", "raise_share", "min_raise", "jump_share", "jump_min_raises", "min_opening"],
      "properties": {
        "peek_seconds": {"type": "number", "minimum": 0},
        "visible_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "countdown_seconds": {"type": "number", "exclusiveMinimum": 0},
        "raise_share": {"type": "number", "exclusiveMinimum": 0},
        "min_raise": {"type": "integer", "minimum": 1},
        "jump_share": {"type": "number", "exclusiveMinimum": 0},
        "jump_min_raises": {"type": "integer", "minimum": 1},
        "min_opening": {"type": "integer", "minimum": 1}
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shelves", "slots_per_shelf", "customers_per_day", "price_step", "customers"],
      "properties": {
        "shelves": {"type": "integer", "minimum": 1},
        "slots_per_shelf": {"type": "integer", "minimum": 1},
        "customers_per_day": {"type": "integer", "minimum": 0},
        "price_step": {"type": "integer", "minimum": 1},
        "customers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
