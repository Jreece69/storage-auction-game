{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item definitions: one file per category in data/items/",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "category", "rarity", "value", "weight", "size", "condition"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "rarity": {"enum": ["common", "uncommon", "rare", "epic", "legendary"]},
      "value": {
        "description": "Base value range in dollars, [min, max], before condition",
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 1}
      },
      "weight": {"description": "Pounds", "type": "integer", "minimum": 0},
      "size": {"description": "Shelf and vehicle slots", "type": "integer", "minimum": 1},
      "condition": {
        "description": "[worst, best] condition it can turn up in, names from economy.json",
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      },
      "sets": {
        "description": "Collection set tags (for collections, a v1.0 feature)",
        "type": "array",
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
