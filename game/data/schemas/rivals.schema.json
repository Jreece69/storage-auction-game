{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rival bidders",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "personality", "budget", "estimate_noise", "risk_appetite", "jump_fold_chance", "reaction_seconds"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "personality": {"enum": ["rookie", "shark", "collector", "bluffer", "grudge"]},
      "budget": {
        "description": "Daily budget in dollars, [min, max]",
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 0}
      },
      "estimate_noise": {
        "description": "Spread of the private estimate around the true value, as a share of it",
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "risk_appetite": {
        "description": "Max bid as a share of the estimate, [min, max]. Above 1 overpays",
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "number", "exclusiveMinimum": 0}
      },
      "jump_fold_chance": {"type": "number", "minimum": 0, "maximum": 1},
      "reaction_seconds": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "number", "minimum": 0}
      },
      "favorite_category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "favorite_bias": {"type": "number", "minimum": 1}
    }
  }
}
