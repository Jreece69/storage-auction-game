# Godot editor and import cache. Regenerated by `--import` or opening the editor.
.godot/

# Translation tables Godot builds from game/data/translations/*.csv on import.
*.translation

# Exported builds.
/build/

# Godot binaries and export templates downloaded by tools/install_godot.sh.
/.tools/

# Written by .github/actions/checkout during CI.
/.lfs-ids.txt

# Never commit Steam or store credentials. They stay on Jack's machine.
tools/steam/*.local.*
.env
*.env

# OS and editor clutter.
.DS_Store
Thumbs.db
*.tmp
*~
.vscode/
.idea/
