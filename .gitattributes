# Store LF in git on every platform. Jack's PC is Windows; Godot reads LF fine
# and this stops CRLF churn from showing up as whole-file diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Big binary assets go through Git LFS.
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Vendored editor add-ons ship a few tiny icons. They stay in plain git so a
# fresh clone works without an LFS step (see docs/DECISIONS.md).
game/addons/**/*.png !filter binary

# Other binaries: never diff or normalize.
*.pdf binary
*.ttf binary
*.otf binary
*.fnt binary
*.exe binary
*.pck binary
*.tpz binary
*.zip binary
